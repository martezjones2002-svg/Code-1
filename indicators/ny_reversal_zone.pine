//@version=6
indicator("NY Reversal Zone", "NY Rev Zone", overlay = true, max_boxes_count = 500)

// Confluence shorthand (from trader's journal), interpreted as:
//   Ts  - Turtle Soup    : price sweeps the session high/low then closes back inside it
//   Fvg - Fair Value Gap : a 3-candle gap formed nearby (inefficiency to react from)
//   IR  - Inversion FVG  : an opposite-direction gap formed nearby (now trading through/inverting it)
//   Cz  - Cons. Encroach : reaction is near the 50% midpoint of the session's high/low range
//   AdvEQ (SMC)          : reaction is near the 50% midpoint of the most recent swing leg
//   Wf  - Wick Rejection : the signal candle itself has a long rejection wick
//   OB  - Order Block    : last opposite candle before a displacement move formed nearby
//   RB  - Rejection Block: a candle with a long rejection wick formed nearby
//   Completed Zones      : a tracked Fvg/OB/RB zone was fully filled (closed through) recently
//   PD Array             : reaction is on the favorable side (discount for longs, premium for shorts)
//                          of the chosen range's 50%

// ── Session ──────────────────────────────────────────────
gSess        = "Session"
sessionInput = input.session("0930-1600", "New York Session", group = gSess)
sessionTZ    = "America/New_York"

t          = time(timeframe.period, sessionInput, sessionTZ)
inSession  = not na(t)
newSession = inSession and not inSession[1]

// ── Reversal Zone ──────────────────────────────────────────────
gZone          = "Reversal Zone"
sweepTicks     = input.int(1, "Min sweep beyond HOD/LOD (ticks)", minval = 0, group = gZone)
wickRatio      = input.float(50, "Min wick rejection (% of candle range)", minval = 0, maxval = 100, group = gZone) / 100
pivotLen       = input.int(5, "Swing pivot length (for Advanced EQ)", minval = 1, group = gZone)
zoneBufferTicks = input.int(40, "Reversal zone buffer beyond swept level (ticks)", minval = 0, group = gZone)
confirmBars    = input.int(3, "Reversal confirmation window (bars after sweep)", minval = 1, group = gZone)

// ── Confluences ──────────────────────────────────────────────
gConf          = "Confluences"
useTS          = input.bool(true, "Ts - Turtle Soup (sweep + close back inside)", group = gConf)
useFVG         = input.bool(true, "Fvg - Fair Value Gap nearby", group = gConf)
useIR          = input.bool(true, "IR - Inversion FVG (opposite gap nearby)", group = gConf)
useCZ          = input.bool(true, "Cz - Consequent Encroachment (session 50%)", group = gConf)
useAdvEQ       = input.bool(true, "Advanced EQ (SMC) - swing leg 50%", group = gConf)
useWF          = input.bool(true, "Wf - Wick Rejection (signal candle)", group = gConf)
useOB          = input.bool(true, "Order Block nearby", group = gConf)
useRB          = input.bool(true, "Rejection Block nearby", group = gConf)
useCompleted   = input.bool(true, "Completed Zones (prior zone fully filled)", group = gConf)
usePD          = input.bool(true, "PD Array - Premium/Discount (favorable side of range)", group = gConf)
pdBasis        = input.string("Session Range", "PD Array range basis", options = ["Session Range", "Swing Leg"], group = gConf)
zoneLookback   = input.int(10, "Nearby lookback (bars)", minval = 1, group = gConf)
nearTicks      = input.int(10, "Nearby price tolerance (ticks)", minval = 0, group = gConf)
ceTicks        = input.int(15, "Cz / Advanced EQ tolerance (ticks)", minval = 1, group = gConf)
minConfluences = input.int(4, "Minimum confluences required", minval = 1, maxval = 10, group = gConf)

// ── Box Style ──────────────────────────────────────────────
gStyle    = "Box Style"
bullColor = input.color(color.new(color.teal, 80), "Bullish zone color", group = gStyle)
bearColor = input.color(color.new(color.red, 80), "Bearish zone color", group = gStyle)
borderCol = input.color(color.new(color.white, 60), "Border color", group = gStyle)

tick = syminfo.mintick

// ── Session High / Low ──────────────────────────────────────────────
var float sessHigh = na
var float sessLow  = na

if newSession
    sessHigh := high
    sessLow  := low
else if inSession
    sessHigh := math.max(sessHigh, high)
    sessLow  := math.min(sessLow, low)

// ── Basic Candle Measurements ──────────────────────────────────────────────
barRange  = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// ── Fvg / Order Block / Rejection Block Events ──────────────────────────────────────────────
bullFVG = high[2] < low
bearFVG = low[2] > high

bullOBevent = close[1] < open[1] and close > high[1]
bearOBevent = close[1] > open[1] and close < low[1]

bullRBevent = barRange > 0 and (lowerWick / barRange) >= wickRatio
bearRBevent = barRange > 0 and (upperWick / barRange) >= wickRatio

// ── Zone Completion Tracking (most recent Fvg/OB/RB per direction) ──────────────────────────────────────────────
// index 0 = Fvg, 1 = Order Block, 2 = Rejection Block
var float[] bullTop      = array.new<float>(3, na)
var float[] bullBottom   = array.new<float>(3, na)
var bool[]  bullActive   = array.new<bool>(3, false)
var int[]   bullEventBar = array.new<int>(3, na)
var float[] bearTop      = array.new<float>(3, na)
var float[] bearBottom   = array.new<float>(3, na)
var bool[]  bearActive   = array.new<bool>(3, false)
var int[]   bearEventBar = array.new<int>(3, na)

var int lastBullCompleted = na
var int lastBearCompleted = na

for idx = 0 to 2
    if array.get(bullActive, idx) and close < array.get(bullBottom, idx)
        array.set(bullActive, idx, false)
        lastBullCompleted := bar_index
    if array.get(bearActive, idx) and close > array.get(bearTop, idx)
        array.set(bearActive, idx, false)
        lastBearCompleted := bar_index

if bullFVG
    array.set(bullTop, 0, low)
    array.set(bullBottom, 0, high[2])
    array.set(bullActive, 0, true)
    array.set(bullEventBar, 0, bar_index)
if bearFVG
    array.set(bearTop, 0, low[2])
    array.set(bearBottom, 0, high)
    array.set(bearActive, 0, true)
    array.set(bearEventBar, 0, bar_index)
if bullOBevent
    array.set(bullTop, 1, high[1])
    array.set(bullBottom, 1, low[1])
    array.set(bullActive, 1, true)
    array.set(bullEventBar, 1, bar_index)
if bearOBevent
    array.set(bearTop, 1, high[1])
    array.set(bearBottom, 1, low[1])
    array.set(bearActive, 1, true)
    array.set(bearEventBar, 1, bar_index)
if bullRBevent
    array.set(bullTop, 2, math.min(open, close))
    array.set(bullBottom, 2, low)
    array.set(bullActive, 2, true)
    array.set(bullEventBar, 2, bar_index)
if bearRBevent
    array.set(bearTop, 2, high)
    array.set(bearBottom, 2, math.max(open, close))
    array.set(bearActive, 2, true)
    array.set(bearEventBar, 2, bar_index)

completedNearBull = not na(lastBullCompleted) and (bar_index - lastBullCompleted) <= zoneLookback
completedNearBear = not na(lastBearCompleted) and (bar_index - lastBearCompleted) <= zoneLookback

// price-proximity: is the current bar within `tol` ticks of a tracked zone's range?
f_near(top, bot, tol) =>
    not na(top) and not na(bot) and low <= top + tol * tick and high >= bot - tol * tick

fvgNearBull = array.get(bullActive, 0) and (bar_index - array.get(bullEventBar, 0)) <= zoneLookback and f_near(array.get(bullTop, 0), array.get(bullBottom, 0), nearTicks)
fvgNearBear = array.get(bearActive, 0) and (bar_index - array.get(bearEventBar, 0)) <= zoneLookback and f_near(array.get(bearTop, 0), array.get(bearBottom, 0), nearTicks)
irNearBull  = array.get(bearActive, 0) and (bar_index - array.get(bearEventBar, 0)) <= zoneLookback and f_near(array.get(bearTop, 0), array.get(bearBottom, 0), nearTicks)  // opposite gap nearby = potential inversion up
irNearBear  = array.get(bullActive, 0) and (bar_index - array.get(bullEventBar, 0)) <= zoneLookback and f_near(array.get(bullTop, 0), array.get(bullBottom, 0), nearTicks)  // opposite gap nearby = potential inversion down
obNearBull  = array.get(bullActive, 1) and (bar_index - array.get(bullEventBar, 1)) <= zoneLookback and f_near(array.get(bullTop, 1), array.get(bullBottom, 1), nearTicks)
obNearBear  = array.get(bearActive, 1) and (bar_index - array.get(bearEventBar, 1)) <= zoneLookback and f_near(array.get(bearTop, 1), array.get(bearBottom, 1), nearTicks)
rbNearBull  = array.get(bullActive, 2) and (bar_index - array.get(bullEventBar, 2)) <= zoneLookback and f_near(array.get(bullTop, 2), array.get(bullBottom, 2), nearTicks)
rbNearBear  = array.get(bearActive, 2) and (bar_index - array.get(bearEventBar, 2)) <= zoneLookback and f_near(array.get(bearTop, 2), array.get(bearBottom, 2), nearTicks)

// ── Midpoint Confluences ──────────────────────────────────────────────
sessMid     = (sessHigh + sessLow) / 2
czCondition = not na(sessMid) and math.abs(close - sessMid) <= ceTicks * tick

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastPivotHigh = na
var float lastPivotLow  = na
if not na(ph)
    lastPivotHigh := ph
if not na(pl)
    lastPivotLow := pl
advEqMid       = (lastPivotHigh + lastPivotLow) / 2
advEqCondition = not na(advEqMid) and math.abs(close - advEqMid) <= ceTicks * tick

// ── PD Array (Premium / Discount) ──────────────────────────────────────────────
pdMid              = pdBasis == "Session Range" ? sessMid : advEqMid
discountCondition  = not na(pdMid) and close < pdMid  // favorable for bullish (long) reactions
premiumCondition   = not na(pdMid) and close > pdMid  // favorable for bearish (short) reactions

wfBear = barRange > 0 and (upperWick / barRange) >= wickRatio
wfBull = barRange > 0 and (lowerWick / barRange) >= wickRatio

// ── Sweep / Confirmation ──────────────────────────────────────────────
// A sweep just marks a candidate; the reversal must then *confirm* within
// `confirmBars` bars (price fails to extend and closes back through the
// prior bar's high/low) rather than requiring both to happen on one candle -
// real tops/bottoms often take a bar or two to actually reject.
sweepHigh = not na(sessHigh[1]) and high >= sessHigh[1] + sweepTicks * tick
sweepLow  = not na(sessLow[1]) and low <= sessLow[1] - sweepTicks * tick

var int   pendingBearBar   = na
var float pendingBearWick  = na
var float pendingBearLevel = na
var int   pendingBullBar   = na
var float pendingBullWick  = na
var float pendingBullLevel = na

if sweepHigh
    pendingBearBar   := bar_index
    pendingBearWick  := high
    pendingBearLevel := sessHigh[1]
if sweepLow
    pendingBullBar   := bar_index
    pendingBullWick  := low
    pendingBullLevel := sessLow[1]

bearPending = not na(pendingBearBar) and (bar_index - pendingBearBar) <= confirmBars
bullPending = not na(pendingBullBar) and (bar_index - pendingBullBar) <= confirmBars

bearTrigger = bearPending and not sweepHigh and close < high[1]
bullTrigger = bullPending and not sweepLow and close > low[1]

tsBear = bearTrigger and (bar_index - pendingBearBar) <= 1  // confirmed same/next bar = classic turtle soup
tsBull = bullTrigger and (bar_index - pendingBullBar) <= 1

bearZoneWick  = pendingBearWick
bearZoneLevel = pendingBearLevel
bullZoneWick  = pendingBullWick
bullZoneLevel = pendingBullLevel

if bearTrigger
    pendingBearBar := na
if bullTrigger
    pendingBullBar := na

// ── Confluence Scoring ──────────────────────────────────────────────
bearCount = (useTS and tsBear ? 1 : 0) + (useFVG and fvgNearBear ? 1 : 0) + (useIR and irNearBear ? 1 : 0) + (useCZ and czCondition ? 1 : 0) + (useAdvEQ and advEqCondition ? 1 : 0) + (useWF and wfBear ? 1 : 0) + (useOB and obNearBear ? 1 : 0) + (useRB and rbNearBear ? 1 : 0) + (useCompleted and completedNearBear ? 1 : 0) + (usePD and premiumCondition ? 1 : 0)
bullCount = (useTS and tsBull ? 1 : 0) + (useFVG and fvgNearBull ? 1 : 0) + (useIR and irNearBull ? 1 : 0) + (useCZ and czCondition ? 1 : 0) + (useAdvEQ and advEqCondition ? 1 : 0) + (useWF and wfBull ? 1 : 0) + (useOB and obNearBull ? 1 : 0) + (useRB and rbNearBull ? 1 : 0) + (useCompleted and completedNearBull ? 1 : 0) + (usePD and discountCondition ? 1 : 0)

bearSignal = inSession and bearTrigger and bearCount >= minConfluences
bullSignal = inSession and bullTrigger and bullCount >= minConfluences

// ── Zone Boxes ──────────────────────────────────────────────
var box[]   activeBoxes  = array.new<box>()
var float[] boxTops      = array.new<float>()
var float[] boxBottoms   = array.new<float>()

if array.size(activeBoxes) > 0
    for i = array.size(activeBoxes) - 1 to 0
        b      = array.get(activeBoxes, i)
        top    = array.get(boxTops, i)
        bottom = array.get(boxBottoms, i)
        tapped = low <= top and high >= bottom
        if tapped
            box.delete(b)
            array.remove(activeBoxes, i)
            array.remove(boxTops, i)
            array.remove(boxBottoms, i)
        else
            box.set_right(b, bar_index + 1)

if bearSignal
    zTop = bearZoneWick
    zBot = bearZoneLevel - zoneBufferTicks * tick
    newBox = box.new(bar_index, zTop, bar_index + 1, zBot, border_color = borderCol, bgcolor = bearColor, extend = extend.none)
    array.push(activeBoxes, newBox)
    array.push(boxTops, zTop)
    array.push(boxBottoms, zBot)

if bullSignal
    zTop = bullZoneLevel + zoneBufferTicks * tick
    zBot = bullZoneWick
    newBox = box.new(bar_index, zTop, bar_index + 1, zBot, border_color = borderCol, bgcolor = bullColor, extend = extend.none)
    array.push(activeBoxes, newBox)
    array.push(boxTops, zTop)
    array.push(boxBottoms, zBot)

alertcondition(bearSignal, "Bearish Reversal Zone", "NY Reversal Zone: bearish zone formed at HOD sweep")
alertcondition(bullSignal, "Bullish Reversal Zone", "NY Reversal Zone: bullish zone formed at LOD sweep")
