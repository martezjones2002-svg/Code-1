//@version=6
indicator("NY Reversal Zone", "NY Rev Zone", overlay = true, max_boxes_count = 500)

// Confluence shorthand (from trader's journal), interpreted as:
//   Ts  - Turtle Soup    : price sweeps the session high/low then closes back inside it
//   Fvg - Fair Value Gap : a 3-candle gap formed nearby (inefficiency to react from)
//   IR  - Inversion FVG  : an opposite-direction gap formed nearby (now trading through/inverting it)
//   Cz  - Cons. Encroach : reaction is near the 50% midpoint of the session's high/low range
//   AdvEQ (SMC)          : reaction is near the 50% midpoint of the most recent swing leg
//   Wf  - Wick Rejection : the signal candle itself has a long rejection wick
//   OB  - Order Block    : last opposite candle before a displacement move formed nearby
//   RB  - Rejection Block: a candle with a long rejection wick formed nearby
//   Completed Zones      : a tracked Fvg/OB/RB zone was fully filled (closed through) recently
//   PD Array             : reaction is on the favorable side (discount for longs, premium for shorts)
//                          of the chosen range's 50%
//   MMM  - Market Maker Model : a tight accumulation range formed right before the sweep
//                               (accumulation -> manipulation/sweep -> expected distribution)
//   STDV - Standard Deviation : reaction is near 1x the swing leg's range projected beyond it
//   OTE  - Optimal Trade Entry: reaction is in the 61.8%-79% retracement zone of the swing leg
//
// A box is drawn the moment a Fvg/Order Block/Rejection Block forms (not
// after price has already reversed away from it) if enough of the above
// confluences line up. It sits at that fixed price, its right edge pushed
// forward every bar, until price actually trades back into it - at which
// point it's deleted. Only one zone box per direction is tracked at a time;
// a new one only appears once the old one has been tapped.

// ── Session ──────────────────────────────────────────────
gSess        = "Session"
sessionInput = input.session("0930-1600", "New York Session", group = gSess)
sessionTZ    = "America/New_York"

t          = time(timeframe.period, sessionInput, sessionTZ)
inSession  = not na(t)
newSession = inSession and not inSession[1]

// ── Reversal Zone ──────────────────────────────────────────────
gZone          = "Reversal Zone"
sweepTicks     = input.int(1, "Min sweep beyond HOD/LOD (ticks)", minval = 0, group = gZone)
wickRatio      = input.float(50, "Min wick rejection (% of candle range)", minval = 0, maxval = 100, group = gZone) / 100
pivotLen       = input.int(5, "Swing pivot length (for Advanced EQ)", minval = 1, group = gZone)
confirmBars    = input.int(3, "Turtle Soup confirmation window (bars after sweep)", minval = 1, group = gZone)
boxWidthBars   = input.int(6, "Zone box width (bars)", minval = 1, group = gZone)
sweepLookback  = input.int(120, "Sweep reference lookback (bars, includes pre-market)", minval = 10, group = gZone)

// ── Confluences ──────────────────────────────────────────────
gConf          = "Confluences"
useTS          = input.bool(true, "Ts - Turtle Soup (sweep + close back inside)", group = gConf)
useFVG         = input.bool(true, "Fvg - Fair Value Gap nearby", group = gConf)
useIR          = input.bool(true, "IR - Inversion FVG (opposite gap nearby)", group = gConf)
useCZ          = input.bool(true, "Cz - Consequent Encroachment (session 50%)", group = gConf)
useAdvEQ       = input.bool(true, "Advanced EQ (SMC) - swing leg 50%", group = gConf)
useWF          = input.bool(true, "Wf - Wick Rejection (signal candle)", group = gConf)
useOB          = input.bool(true, "Order Block nearby", group = gConf)
useRB          = input.bool(true, "Rejection Block nearby", group = gConf)
useCompleted   = input.bool(true, "Completed Zones (prior zone fully filled)", group = gConf)
usePD          = input.bool(true, "PD Array - Premium/Discount (favorable side of range)", group = gConf)
useMMM         = input.bool(true, "MMM - Market Maker Model (accumulation before sweep)", group = gConf)
useSTDV        = input.bool(true, "STDV - near 1 standard deviation extension", group = gConf)
useOTE         = input.bool(true, "OTE - Optimal Trade Entry (61.8%-79% retracement)", group = gConf)
pdBasis        = input.string("Session Range", "PD Array range basis", options = ["Session Range", "Swing Leg"], group = gConf)
accumBars      = input.int(10, "MMM accumulation lookback (bars)", minval = 2, group = gConf)
accumRatio     = input.float(2.0, "MMM max accumulation range (x sweep bar range)", minval = 1.0, group = gConf)
zoneLookback   = input.int(10, "Nearby lookback (bars)", minval = 1, group = gConf)
nearTicks      = input.int(10, "Nearby price tolerance (ticks)", minval = 0, group = gConf)
ceTicks        = input.int(15, "Cz / Advanced EQ / STDV tolerance (ticks)", minval = 1, group = gConf)
minConfluences = input.int(4, "Minimum confluences required", minval = 1, maxval = 13, group = gConf)

// ── Box Style ──────────────────────────────────────────────
gStyle    = "Box Style"
bullColor = input.color(color.new(color.teal, 80), "Bullish zone color", group = gStyle)
bearColor = input.color(color.new(color.red, 80), "Bearish zone color", group = gStyle)
borderCol = input.color(color.new(color.white, 60), "Border color", group = gStyle)

// ── Tap Outcome Stats ──────────────────────────────────────────────
// A tap isn't a guaranteed reversal - this tracks, for every zone that gets
// tapped, whether price actually moved away by a meaningful amount within a
// following window, or just kept going (continuation/false signal), and
// keeps a running win rate instead of you having to count by hand.
gStats             = "Stats"
outcomeBars        = input.int(10, "Bars to judge tap outcome", minval = 1, group = gStats)
reversalTicks      = input.int(20, "Min move away from zone to count as reversal (ticks)", minval = 1, group = gStats)
showStats          = input.bool(true, "Show win-rate table", group = gStats)
showConfluenceStats = input.bool(false, "Show per-confluence breakdown table (large)", group = gStats)

tick = syminfo.mintick

// ── Session High / Low ──────────────────────────────────────────────
var float sessHigh = na
var float sessLow  = na

if newSession
    sessHigh := high
    sessLow  := low
else if inSession
    sessHigh := math.max(sessHigh, high)
    sessLow  := math.min(sessLow, low)

// ── Basic Candle Measurements ──────────────────────────────────────────────
barRange  = high - low
upperWick = high - math.max(open, close)
lowerWick = math.min(open, close) - low

// ── Fvg / Order Block / Rejection Block Events ──────────────────────────────────────────────
bullFVG = high[2] < low
bearFVG = low[2] > high

bullOBevent = close[1] < open[1] and close > high[1]
bearOBevent = close[1] > open[1] and close < low[1]

bullRBevent = barRange > 0 and (lowerWick / barRange) >= wickRatio
bearRBevent = barRange > 0 and (upperWick / barRange) >= wickRatio

// ── Zone Completion Tracking (most recent Fvg/OB/RB per direction) ──────────────────────────────────────────────
// index 0 = Fvg, 1 = Order Block, 2 = Rejection Block
var float[] bullTop      = array.new<float>(3, na)
var float[] bullBottom   = array.new<float>(3, na)
var bool[]  bullActive   = array.new<bool>(3, false)
var int[]   bullEventBar = array.new<int>(3, na)
var float[] bearTop      = array.new<float>(3, na)
var float[] bearBottom   = array.new<float>(3, na)
var bool[]  bearActive   = array.new<bool>(3, false)
var int[]   bearEventBar = array.new<int>(3, na)

var int lastBullCompleted = na
var int lastBearCompleted = na

for idx = 0 to 2
    if array.get(bullActive, idx) and close < array.get(bullBottom, idx)
        array.set(bullActive, idx, false)
        lastBullCompleted := bar_index
    if array.get(bearActive, idx) and close > array.get(bearTop, idx)
        array.set(bearActive, idx, false)
        lastBearCompleted := bar_index

if bullFVG
    array.set(bullTop, 0, low)
    array.set(bullBottom, 0, high[2])
    array.set(bullActive, 0, true)
    array.set(bullEventBar, 0, bar_index)
if bearFVG
    array.set(bearTop, 0, low[2])
    array.set(bearBottom, 0, high)
    array.set(bearActive, 0, true)
    array.set(bearEventBar, 0, bar_index)
if bullOBevent
    array.set(bullTop, 1, high[1])
    array.set(bullBottom, 1, low[1])
    array.set(bullActive, 1, true)
    array.set(bullEventBar, 1, bar_index)
if bearOBevent
    array.set(bearTop, 1, high[1])
    array.set(bearBottom, 1, low[1])
    array.set(bearActive, 1, true)
    array.set(bearEventBar, 1, bar_index)
if bullRBevent
    array.set(bullTop, 2, math.min(open, close))
    array.set(bullBottom, 2, low)
    array.set(bullActive, 2, true)
    array.set(bullEventBar, 2, bar_index)
if bearRBevent
    array.set(bearTop, 2, high)
    array.set(bearBottom, 2, math.max(open, close))
    array.set(bearActive, 2, true)
    array.set(bearEventBar, 2, bar_index)

completedNearBull = not na(lastBullCompleted) and (bar_index - lastBullCompleted) <= zoneLookback
completedNearBear = not na(lastBearCompleted) and (bar_index - lastBearCompleted) <= zoneLookback

// price-proximity: is the current bar within `tol` ticks of a tracked zone's range?
f_near(top, bot, tol) =>
    not na(top) and not na(bot) and low <= top + tol * tick and high >= bot - tol * tick

fvgNearBull = array.get(bullActive, 0) and (bar_index - array.get(bullEventBar, 0)) <= zoneLookback and f_near(array.get(bullTop, 0), array.get(bullBottom, 0), nearTicks)
fvgNearBear = array.get(bearActive, 0) and (bar_index - array.get(bearEventBar, 0)) <= zoneLookback and f_near(array.get(bearTop, 0), array.get(bearBottom, 0), nearTicks)
irNearBull  = array.get(bearActive, 0) and (bar_index - array.get(bearEventBar, 0)) <= zoneLookback and f_near(array.get(bearTop, 0), array.get(bearBottom, 0), nearTicks)  // opposite gap nearby = potential inversion up
irNearBear  = array.get(bullActive, 0) and (bar_index - array.get(bullEventBar, 0)) <= zoneLookback and f_near(array.get(bullTop, 0), array.get(bullBottom, 0), nearTicks)  // opposite gap nearby = potential inversion down
obNearBull  = array.get(bullActive, 1) and (bar_index - array.get(bullEventBar, 1)) <= zoneLookback and f_near(array.get(bullTop, 1), array.get(bullBottom, 1), nearTicks)
obNearBear  = array.get(bearActive, 1) and (bar_index - array.get(bearEventBar, 1)) <= zoneLookback and f_near(array.get(bearTop, 1), array.get(bearBottom, 1), nearTicks)
rbNearBull  = array.get(bullActive, 2) and (bar_index - array.get(bullEventBar, 2)) <= zoneLookback and f_near(array.get(bullTop, 2), array.get(bullBottom, 2), nearTicks)
rbNearBear  = array.get(bearActive, 2) and (bar_index - array.get(bearEventBar, 2)) <= zoneLookback and f_near(array.get(bearTop, 2), array.get(bearBottom, 2), nearTicks)

// ── Midpoint Confluences ──────────────────────────────────────────────
sessMid     = (sessHigh + sessLow) / 2
czCondition = not na(sessMid) and math.abs(close - sessMid) <= ceTicks * tick

ph = ta.pivothigh(pivotLen, pivotLen)
pl = ta.pivotlow(pivotLen, pivotLen)
var float lastPivotHigh = na
var float lastPivotLow  = na
if not na(ph)
    lastPivotHigh := ph
if not na(pl)
    lastPivotLow := pl
advEqMid       = (lastPivotHigh + lastPivotLow) / 2
advEqCondition = not na(advEqMid) and math.abs(close - advEqMid) <= ceTicks * tick

// ── STDV (1 standard deviation extension beyond the swing leg) ──────────────────────────────────────────────
pivotRange     = lastPivotHigh - lastPivotLow
stdvBearLevel  = lastPivotHigh + pivotRange
stdvBullLevel  = lastPivotLow - pivotRange
stdvBearCondition = not na(stdvBearLevel) and math.abs(close - stdvBearLevel) <= ceTicks * tick
stdvBullCondition = not na(stdvBullLevel) and math.abs(close - stdvBullLevel) <= ceTicks * tick

// ── OTE (61.8%-79% retracement of the swing leg) ──────────────────────────────────────────────
oteBearBot = lastPivotLow + pivotRange * 0.618
oteBearTop = lastPivotLow + pivotRange * 0.79
oteBullTop = lastPivotHigh - pivotRange * 0.618
oteBullBot = lastPivotHigh - pivotRange * 0.79
oteBearCondition = not na(oteBearTop) and close >= oteBearBot and close <= oteBearTop
oteBullCondition = not na(oteBullTop) and close >= oteBullBot and close <= oteBullTop

// ── MMM (tight accumulation range right before the sweep) ──────────────────────────────────────────────
accumRange   = ta.highest(high, accumBars)[1] - ta.lowest(low, accumBars)[1]
mmmCondition = accumRange > 0 and barRange > 0 and accumRange <= accumRatio * barRange

// ── PD Array (Premium / Discount) ──────────────────────────────────────────────
pdMid              = pdBasis == "Session Range" ? sessMid : advEqMid
discountCondition  = not na(pdMid) and close < pdMid  // favorable for bullish (long) reactions
premiumCondition   = not na(pdMid) and close > pdMid  // favorable for bearish (short) reactions

wfBear = barRange > 0 and (upperWick / barRange) >= wickRatio
wfBull = barRange > 0 and (lowerWick / barRange) >= wickRatio

// ── Sweep / Confirmation ──────────────────────────────────────────────
// A sweep just marks a candidate; the reversal must then *confirm* within
// `confirmBars` bars (price fails to extend and closes back through the
// prior bar's high/low) rather than requiring both to happen on one candle -
// real tops/bottoms often take a bar or two to actually reject.
//
// The prior high/low being swept is measured over a rolling lookback that
// spans pre-market too, not just the current 09:30-16:00 session's own
// range - otherwise the session's very first bars have no "prior session
// high/low" yet to sweep, and the actual open-of-day reversal (often a
// sweep of the overnight low/high) gets structurally excluded.
priorHigh = ta.highest(high, sweepLookback)[1]
priorLow  = ta.lowest(low, sweepLookback)[1]
sweepHigh = not na(priorHigh) and high >= priorHigh + sweepTicks * tick
sweepLow  = not na(priorLow) and low <= priorLow - sweepTicks * tick

var int pendingBearBar = na
var int pendingBullBar = na

if sweepHigh
    pendingBearBar := bar_index
if sweepLow
    pendingBullBar := bar_index

bearPending = not na(pendingBearBar) and (bar_index - pendingBearBar) <= confirmBars
bullPending = not na(pendingBullBar) and (bar_index - pendingBullBar) <= confirmBars

bearTrigger = bearPending and not sweepHigh and close < high[1]
bullTrigger = bullPending and not sweepLow and close > low[1]

tsBear = bearTrigger and (bar_index - pendingBearBar) <= 1  // confirmed same/next bar = classic turtle soup
tsBull = bullTrigger and (bar_index - pendingBullBar) <= 1

if bearTrigger
    pendingBearBar := na
if bullTrigger
    pendingBullBar := na

// ── Confluence Scoring ──────────────────────────────────────────────
bearCount = (useTS and tsBear ? 1 : 0) + (useFVG and fvgNearBear ? 1 : 0) + (useIR and irNearBear ? 1 : 0) + (useCZ and czCondition ? 1 : 0) + (useAdvEQ and advEqCondition ? 1 : 0) + (useWF and wfBear ? 1 : 0) + (useOB and obNearBear ? 1 : 0) + (useRB and rbNearBear ? 1 : 0) + (useCompleted and completedNearBear ? 1 : 0) + (usePD and premiumCondition ? 1 : 0) + (useMMM and mmmCondition ? 1 : 0) + (useSTDV and stdvBearCondition ? 1 : 0) + (useOTE and oteBearCondition ? 1 : 0)
bullCount = (useTS and tsBull ? 1 : 0) + (useFVG and fvgNearBull ? 1 : 0) + (useIR and irNearBull ? 1 : 0) + (useCZ and czCondition ? 1 : 0) + (useAdvEQ and advEqCondition ? 1 : 0) + (useWF and wfBull ? 1 : 0) + (useOB and obNearBull ? 1 : 0) + (useRB and rbNearBull ? 1 : 0) + (useCompleted and completedNearBull ? 1 : 0) + (usePD and discountCondition ? 1 : 0) + (useMMM and mmmCondition ? 1 : 0) + (useSTDV and stdvBullCondition ? 1 : 0) + (useOTE and oteBullCondition ? 1 : 0)

// raw (un-gated by the useX toggles) per-confluence flags, snapshotted per zone so a
// tap's eventual win/loss can be attributed back to which confluences were actually present
var string[] confNames = array.from("Ts", "Fvg", "IR", "Cz", "AdvEQ", "Wf", "OB", "RB", "Completed", "PD", "MMM", "STDV", "OTE")
nConf = array.size(confNames)
bearConfVals = array.from(tsBear, fvgNearBear, irNearBear, czCondition, advEqCondition, wfBear, obNearBear, rbNearBear, completedNearBear, premiumCondition, mmmCondition, stdvBearCondition, oteBearCondition)
bullConfVals = array.from(tsBull, fvgNearBull, irNearBull, czCondition, advEqCondition, wfBull, obNearBull, rbNearBull, completedNearBull, discountCondition, mmmCondition, stdvBullCondition, oteBullCondition)

// ── Zone Formation (the box appears here, not after a confirmed reversal) ──────────────────────────────────────────────
// Require the pattern to actually be at a real reversal point - it must
// form at/within `confirmBars` bars of an actual sweep of the prior
// session high/low, not just anywhere an OB/Fvg/RB candle happens to occur
// mid-trend.
newBearZoneEvent = (bearOBevent or bearFVG or bearRBevent) and bearPending
newBullZoneEvent = (bullOBevent or bullFVG or bullRBevent) and bullPending

// priority when more than one forms on the same bar: Order Block > Fvg > Rejection Block
bearEventTop = bearOBevent ? high[1] : bearFVG ? low[2] : high
bearEventBot = bearOBevent ? low[1]  : bearFVG ? high   : math.max(open, close)
bullEventTop = bullOBevent ? high[1] : bullFVG ? low    : math.min(open, close)
bullEventBot = bullOBevent ? low[1]  : bullFVG ? high[2] : low

var box   bearZoneBox = na
var float bearZoneTop = na
var float bearZoneBot = na
var box   bullZoneBox = na
var float bullZoneTop = na
var float bullZoneBot = na

var int bearZonesFormed = 0
var int bullZonesFormed = 0
var int bearTaps        = 0
var int bullTaps        = 0
var int bearReversals   = 0
var int bullReversals   = 0

var int   pendingBearOutcomeBar   = na
var float pendingBearOutcomeLevel = na
var int   pendingBullOutcomeBar   = na
var float pendingBullOutcomeLevel = na

var bool[] bearZoneConf    = array.new<bool>(nConf, false)  // confluences present when the *current* zone formed
var bool[] bullZoneConf    = array.new<bool>(nConf, false)
var bool[] pendingBearConf = array.new<bool>(nConf, false)  // snapshot carried through to outcome resolution
var bool[] pendingBullConf = array.new<bool>(nConf, false)

var int[] confPresentCount = array.new<int>(nConf, 0)
var int[] confWinCount     = array.new<int>(nConf, 0)

f_recordOutcome(win, snapshot) =>
    for k = 0 to nConf - 1
        if array.get(snapshot, k)
            array.set(confPresentCount, k, array.get(confPresentCount, k) + 1)
            if win
                array.set(confWinCount, k, array.get(confWinCount, k) + 1)

// ── Zone Boxes (one active box per direction; replaced only once tapped) ──────────────────────────────────────────────
// Fixed width, both edges shift forward together each bar - it slides
// across the chart at a constant size instead of stretching wider forever.
// Runs before the signal gate below so a box tapped on this same bar can be
// immediately replaced by a new one, instead of waiting a bar.
if not na(bearZoneBox)
    if low <= bearZoneTop and high >= bearZoneBot
        box.delete(bearZoneBox)
        bearZoneBox := na
        if not na(pendingBearOutcomeBar)  // resolve an earlier still-pending tap early using current price
            f_recordOutcome(close <= pendingBearOutcomeLevel - reversalTicks * tick, pendingBearConf)
            if close <= pendingBearOutcomeLevel - reversalTicks * tick
                bearReversals := bearReversals + 1
        bearTaps                := bearTaps + 1
        pendingBearOutcomeBar   := bar_index
        pendingBearOutcomeLevel := bearZoneBot
        pendingBearConf         := bearZoneConf
    else
        box.set_left(bearZoneBox, bar_index - boxWidthBars + 1)
        box.set_right(bearZoneBox, bar_index + 1)

if not na(bullZoneBox)
    if low <= bullZoneTop and high >= bullZoneBot
        box.delete(bullZoneBox)
        bullZoneBox := na
        if not na(pendingBullOutcomeBar)
            f_recordOutcome(close >= pendingBullOutcomeLevel + reversalTicks * tick, pendingBullConf)
            if close >= pendingBullOutcomeLevel + reversalTicks * tick
                bullReversals := bullReversals + 1
        bullTaps                := bullTaps + 1
        pendingBullOutcomeBar   := bar_index
        pendingBullOutcomeLevel := bullZoneTop
        pendingBullConf         := bullZoneConf
    else
        box.set_left(bullZoneBox, bar_index - boxWidthBars + 1)
        box.set_right(bullZoneBox, bar_index + 1)

// judge a pending tap's outcome once outcomeBars have passed
if not na(pendingBearOutcomeBar) and (bar_index - pendingBearOutcomeBar) >= outcomeBars
    bearWin = close <= pendingBearOutcomeLevel - reversalTicks * tick
    f_recordOutcome(bearWin, pendingBearConf)
    if bearWin
        bearReversals := bearReversals + 1
    pendingBearOutcomeBar := na
if not na(pendingBullOutcomeBar) and (bar_index - pendingBullOutcomeBar) >= outcomeBars
    bullWin = close >= pendingBullOutcomeLevel + reversalTicks * tick
    f_recordOutcome(bullWin, pendingBullConf)
    if bullWin
        bullReversals := bullReversals + 1
    pendingBullOutcomeBar := na

bearZoneSignal = inSession and newBearZoneEvent and bearCount >= minConfluences and na(bearZoneBox)
bullZoneSignal = inSession and newBullZoneEvent and bullCount >= minConfluences and na(bullZoneBox)

// alias kept for alertcondition naming below
bearSignal = bearZoneSignal
bullSignal = bullZoneSignal

if bearZoneSignal
    bearZoneTop  := bearEventTop
    bearZoneBot  := bearEventBot
    bearZoneBox  := box.new(bar_index - boxWidthBars + 1, bearZoneTop, bar_index + 1, bearZoneBot, border_color = borderCol, bgcolor = bearColor, extend = extend.none)
    bearZoneConf := bearConfVals
    bearZonesFormed := bearZonesFormed + 1

if bullZoneSignal
    bullZoneTop  := bullEventTop
    bullZoneBot  := bullEventBot
    bullZoneBox  := box.new(bar_index - boxWidthBars + 1, bullZoneTop, bar_index + 1, bullZoneBot, border_color = borderCol, bgcolor = bullColor, extend = extend.none)
    bullZoneConf := bullConfVals
    bullZonesFormed := bullZonesFormed + 1

alertcondition(bearSignal, "Bearish Reversal Zone", "NY Reversal Zone: bearish zone formed")
alertcondition(bullSignal, "Bullish Reversal Zone", "NY Reversal Zone: bullish zone formed")

// ── Stats Table ──────────────────────────────────────────────
var table statsTable = table.new(position.top_right, 2, 4, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

if showStats and barstate.islast
    bearWinPct  = bearTaps > 0 ? (bearReversals / bearTaps) * 100 : na
    bullWinPct  = bullTaps > 0 ? (bullReversals / bullTaps) * 100 : na
    totalTaps   = bearTaps + bullTaps
    totalRev    = bearReversals + bullReversals
    totalWinPct = totalTaps > 0 ? (totalRev / totalTaps) * 100 : na

    table.cell(statsTable, 0, 0, "Zone", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(statsTable, 1, 0, "Formed/Tap/Win%", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(statsTable, 0, 1, "Bear", text_color = color.white)
    table.cell(statsTable, 1, 1, str.tostring(bearZonesFormed) + " / " + str.tostring(bearTaps) + " / " + (na(bearWinPct) ? "-" : str.tostring(bearWinPct, "#.0") + "%"), text_color = color.white)
    table.cell(statsTable, 0, 2, "Bull", text_color = color.white)
    table.cell(statsTable, 1, 2, str.tostring(bullZonesFormed) + " / " + str.tostring(bullTaps) + " / " + (na(bullWinPct) ? "-" : str.tostring(bullWinPct, "#.0") + "%"), text_color = color.white)
    table.cell(statsTable, 0, 3, "Total", text_color = color.white)
    table.cell(statsTable, 1, 3, str.tostring(totalTaps) + " taps / " + (na(totalWinPct) ? "-" : str.tostring(totalWinPct, "#.0") + "%"), text_color = color.white)

// ── Per-Confluence Win Rate Table ──────────────────────────────────────────────
// Which confluences actually correlate with a zone reversing, vs just padding the count.
// Off by default and compact (one merged column, tiny text) since a 14-row table
// eats most of a phone screen - turn it on with showConfluenceStats when you
// actually want to dig into it.
var table confTable = table.new(position.bottom_right, 2, 14, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

if showConfluenceStats and barstate.islast
    table.cell(confTable, 0, 0, "Confl.", text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.tiny)
    table.cell(confTable, 1, 0, "N/Win%", text_color = color.white, bgcolor = color.new(color.gray, 40), text_size = size.tiny)
    for k = 0 to nConf - 1
        present = array.get(confPresentCount, k)
        wins    = array.get(confWinCount, k)
        winPct  = present > 0 ? (wins / present) * 100 : na
        table.cell(confTable, 0, k + 1, array.get(confNames, k), text_color = color.white, text_size = size.tiny)
        table.cell(confTable, 1, k + 1, str.tostring(present) + " / " + (na(winPct) ? "-" : str.tostring(winPct, "#.0") + "%"), text_color = color.white, text_size = size.tiny)
