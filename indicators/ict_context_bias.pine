//@version=6
indicator("ICT Context & Bias", "ICT Bias", overlay = true, max_lines_count = 500, max_labels_count = 50, max_boxes_count = 50)

// Stage 1 of a multi-stage build: context/bias only. No PD arrays, no entry
// signals yet - this just automates the manual markup (opening prices,
// PDH/PDL/PWH/PWL, session highs/lows, RS) so bias is readable at a glance.
//
// Open questions / assumptions (flag if wrong):
//   - "True Day Open" = 00:00, "Daily Open" = the 18:00 daily candle open.
//   - Asia/London/NY AM/NY PM session clock times were never given exactly -
//     defaults below are common ICT conventions, adjustable via inputs.
//   - Range Settlement's exact formula isn't disclosed (computed by a
//     separate proprietary indicator per the notes) - wired as a manual
//     price input rather than guessed at.

tz   = "America/New_York"
tick = syminfo.mintick

// ── Opening Prices ──────────────────────────────────────────────
gOpens        = "Opening Prices"
showTrueDay   = input.bool(true, "True Day Open (00:00)", group = gOpens)
show0830      = input.bool(true, "8:30 Open", group = gOpens)
show0930      = input.bool(true, "9:30 Open", group = gOpens)
show1330      = input.bool(true, "13:30 Open", group = gOpens)
showDailyOpen = input.bool(true, "Daily Candle Open (18:00)", group = gOpens)
showWeeklyOpen = input.bool(true, "Weekly Open (Sun 18:00)", group = gOpens)

// ── Previous Range ──────────────────────────────────────────────
gRange           = "Previous Range"
showPDHPDL       = input.bool(true, "Previous Day High/Low", group = gRange)
showPWHPWL       = input.bool(true, "Previous Week High/Low", group = gRange)
showPDRQuadrants = input.bool(true, "Previous Day Range Quadrants", group = gRange)

// ── Sessions (Highs/Lows) ──────────────────────────────────────────────
gSess        = "Sessions (Highs/Lows) - default times, adjust as needed"
showAsia     = input.bool(true, "Asia Session H/L", group = gSess)
asiaSession  = input.session("2000-0000", "Asia Session Time", group = gSess)
showLondon   = input.bool(true, "London Session H/L", group = gSess)
londonSession = input.session("0200-0500", "London Session Time", group = gSess)
showNYAM     = input.bool(true, "NY AM Session H/L", group = gSess)
nyamSession  = input.session("0930-1200", "NY AM Session Time", group = gSess)
showNYPM     = input.bool(true, "NY PM Session H/L", group = gSess)
nypmSession  = input.session("1330-1600", "NY PM Session Time", group = gSess)

// ── Range Settlement (manual - formula not disclosed) ──────────────────────────────────────────────
gRS             = "Range Settlement (manual entry)"
rsPriceInput    = input.float(0.0, "Today's RS Price (from your RS indicator, 0 = off)", group = gRS)
rsPrice         = rsPriceInput > 0 ? rsPriceInput : na
showRSQuadrants = input.bool(true, "Show RS Quadrants (9:30 Open -> RS)", group = gRS)

// ── Style ──────────────────────────────────────────────
gStyle        = "Style"
lineWidth     = input.int(1, "Line Width", minval = 1, group = gStyle)
showBiasTable = input.bool(true, "Show Bias Table", group = gStyle)

// ── Helpers ──────────────────────────────────────────────
// Detect the first bar of a recurring daily clock time and draw/refresh a
// persistent right-extending line at that bar's open. Each call site keeps
// its own independent state (Pine tracks `var` per call-site).
f_openLine(sessStr, show, col, lbl) =>
    var float lvl = na
    var line ln = na
    var label la = na
    t = time(timeframe.period, sessStr, tz)
    isNew = not na(t) and na(t[1])
    if isNew
        lvl := open
        if not na(ln)
            line.delete(ln)
            label.delete(la)
        if show
            ln := line.new(bar_index, lvl, bar_index + 1, lvl, extend = extend.right, color = col, width = lineWidth)
            la := label.new(bar_index, lvl, lbl, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
    lvl

// Detect the first bar of the week (Sunday 18:00 NY) specifically.
f_weeklyOpenLine(show, col, lbl) =>
    var float lvl = na
    var line ln = na
    var label la = na
    t = time(timeframe.period, "1800-1801", tz)
    isSun = dayofweek(time, tz) == dayofweek.sunday
    isNew = not na(t) and isSun and not (not na(t[1]) and dayofweek(time[1], tz) == dayofweek.sunday)
    if isNew
        lvl := open
        if not na(ln)
            line.delete(ln)
            label.delete(la)
        if show
            ln := line.new(bar_index, lvl, bar_index + 1, lvl, extend = extend.right, color = col, width = lineWidth)
            la := label.new(bar_index, lvl, lbl, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
    lvl

// Rolling session high/low: tracks live during the session, freezes and
// draws a line for the completed range once the session ends.
f_sessionHL(sessStr, show, col, lblH, lblL) =>
    var float sH = na
    var float sL = na
    var line lnH = na
    var line lnL = na
    t = time(timeframe.period, sessStr, tz)
    inSess = not na(t)
    isNew = inSess and na(t[1])
    if isNew
        sH := high
        sL := low
    else if inSess
        sH := math.max(sH, high)
        sL := math.min(sL, low)
    justEnded = not inSess and not na(t[1])
    if justEnded and show
        if not na(lnH)
            line.delete(lnH)
            line.delete(lnL)
        lnH := line.new(bar_index - 1, sH, bar_index, sH, extend = extend.right, color = col, width = lineWidth)
        lnL := line.new(bar_index - 1, sL, bar_index, sL, extend = extend.right, color = col, width = lineWidth)
        label.new(bar_index, sH, lblH, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
        label.new(bar_index, sL, lblL, style = label.style_label_left, color = color.new(col, 100), textcolor = col, size = size.small)
    [sH, sL]

// ── Opening Price Lines ──────────────────────────────────────────────
trueDayOpen  = f_openLine("0000-0001", showTrueDay, color.gray, "True Day Open")
open0830     = f_openLine("0830-0831", show0830, color.orange, "8:30 Open")
open0930     = f_openLine("0930-0931", show0930, color.blue, "9:30 Open")
open1330     = f_openLine("1330-1331", show1330, color.purple, "13:30 Open")
dailyOpen    = f_openLine("1800-1801", showDailyOpen, color.black, "Daily Open")
weeklyOpen   = f_weeklyOpenLine(showWeeklyOpen, color.new(color.orange, 0), "Weekly Open")

// ── Previous Day / Week High-Low (segmented by Daily Open / Weekly Open) ──────────────────────────────────────────────
var float dayHigh = na
var float dayLow  = na
var float pdh     = na
var float pdl     = na
var line pdhLine  = na
var line pdlLine  = na

tDaily     = time(timeframe.period, "1800-1801", tz)
newDay     = not na(tDaily) and na(tDaily[1])
if newDay
    if not na(dayHigh)
        pdh := dayHigh
        pdl := dayLow
        if showPDHPDL
            if not na(pdhLine)
                line.delete(pdhLine)
                line.delete(pdlLine)
            pdhLine := line.new(bar_index - 1, pdh, bar_index, pdh, extend = extend.right, color = color.red, width = lineWidth, style = line.style_dashed)
            pdlLine := line.new(bar_index - 1, pdl, bar_index, pdl, extend = extend.right, color = color.green, width = lineWidth, style = line.style_dashed)
    dayHigh := high
    dayLow  := low
else
    dayHigh := math.max(nz(dayHigh, high), high)
    dayLow  := math.min(nz(dayLow, low), low)

var float weekHigh = na
var float weekLow  = na
var float pwh      = na
var float pwl      = na
var line pwhLine   = na
var line pwlLine   = na

tWeekly   = time(timeframe.period, "1800-1801", tz)
isSunNow  = dayofweek(time, tz) == dayofweek.sunday
newWeek   = not na(tWeekly) and isSunNow and not (not na(tWeekly[1]) and dayofweek(time[1], tz) == dayofweek.sunday)
if newWeek
    if not na(weekHigh)
        pwh := weekHigh
        pwl := weekLow
        if showPWHPWL
            if not na(pwhLine)
                line.delete(pwhLine)
                line.delete(pwlLine)
            pwhLine := line.new(bar_index - 1, pwh, bar_index, pwh, extend = extend.right, color = color.new(color.red, 40), width = lineWidth, style = line.style_dotted)
            pwlLine := line.new(bar_index - 1, pwl, bar_index, pwl, extend = extend.right, color = color.new(color.green, 40), width = lineWidth, style = line.style_dotted)
    weekHigh := high
    weekLow  := low
else
    weekHigh := math.max(nz(weekHigh, high), high)
    weekLow  := math.min(nz(weekLow, low), low)

// ── PDR Quadrants ──────────────────────────────────────────────
var line[] pdrQuadLines = array.new<line>()
if newDay and showPDRQuadrants and not na(pdh) and not na(pdl)
    if array.size(pdrQuadLines) > 0
        for i = 0 to array.size(pdrQuadLines) - 1
            line.delete(array.get(pdrQuadLines, i))
        array.clear(pdrQuadLines)
    rng = pdh - pdl
    for q = 0 to 4
        lvl = pdl + rng * (q / 4.0)
        qLine = line.new(bar_index - 1, lvl, bar_index, lvl, extend = extend.right, color = color.new(color.gray, 60), width = 1, style = line.style_dotted)
        array.push(pdrQuadLines, qLine)

// ── Session Highs/Lows ──────────────────────────────────────────────
[asiaH, asiaL]   = f_sessionHL(asiaSession, showAsia, color.fuchsia, "Asia High", "Asia Low")
[londonH, londonL] = f_sessionHL(londonSession, showLondon, color.teal, "London High", "London Low")
[nyamH, nyamL]   = f_sessionHL(nyamSession, showNYAM, color.blue, "NY AM High", "NY AM Low")
[nypmH, nypmL]   = f_sessionHL(nypmSession, showNYPM, color.navy, "NY PM High", "NY PM Low")

// ── Range Settlement (manual) ──────────────────────────────────────────────
var line rsLine = na
var line[] rsQuadLines = array.new<line>()
if not na(rsPrice)
    if barstate.isfirst or na(rsLine)
        rsLine := line.new(bar_index, rsPrice, bar_index + 1, rsPrice, extend = extend.right, color = color.red, width = lineWidth + 1)
    else
        line.set_y1(rsLine, rsPrice)
        line.set_y2(rsLine, rsPrice)

t0930 = time(timeframe.period, "0930-0931", tz)
new0930 = not na(t0930) and na(t0930[1])
if new0930 and showRSQuadrants and not na(rsPrice)
    if array.size(rsQuadLines) > 0
        for i = 0 to array.size(rsQuadLines) - 1
            line.delete(array.get(rsQuadLines, i))
        array.clear(rsQuadLines)
    base = open
    rng2 = rsPrice - base
    for q = 0 to 4
        lvl = base + rng2 * (q / 4.0)
        qLine2 = line.new(bar_index - 1, lvl, bar_index, lvl, extend = extend.right, color = color.new(color.red, 60), width = 1, style = line.style_dotted)
        array.push(rsQuadLines, qLine2)

// ══════════════════════════════════════════════════════════════════
// STAGE 2a: PD ARRAYS — Order Blocks
// ══════════════════════════════════════════════════════════════════
// Bullish OB: the last down-close candle before a strong up expansion.
// Bearish OB: the last up-close candle before a strong down expansion.
// POI: the OB candle's opening price if its wick > body, otherwise the CE
// (midpoint of the full candle range). One active OB per direction at a
// time - a new one only replaces the old once it's been tapped.
//
// Known limitation: this only catches the OB candle sitting immediately
// before the expansion leg. Your notes showed a valid example where a
// small pullback/consolidation sits between the true OB candle and the
// actual expansion - that variant isn't detected yet.

gOB                = "Order Blocks"
useOB              = input.bool(true, "Show Order Blocks", group = gOB)
obLookback         = input.int(20, "Avg range lookback (bars)", minval = 5, group = gOB)
obDisplacementMult = input.float(1.5, "Min displacement (x avg range)", minval = 1.0, group = gOB)
obWidthBars        = input.int(6, "OB box width (bars)", minval = 1, group = gOB)
bullOBColor        = input.color(color.new(color.teal, 80), "Bullish OB color", group = gOB)
bearOBColor        = input.color(color.new(color.red, 80), "Bearish OB color", group = gOB)

avgRange     = ta.sma(high - low, obLookback)
displacement = (high - low) > avgRange * obDisplacementMult

bullOBevent = close[1] < open[1] and close > high[1] and displacement
bearOBevent = close[1] > open[1] and close < low[1] and displacement

obBody1        = math.abs(close[1] - open[1])
obWick1        = (high[1] - low[1]) - obBody1
obUseOpenPrice = obWick1 > obBody1
obPOI          = obUseOpenPrice ? open[1] : (high[1] + low[1]) / 2

var box   bullOBBox   = na
var float bullOBTopV  = na
var float bullOBBotV  = na
var float bullOBPOIv  = na
var line  bullOBPOIln = na

var box   bearOBBox   = na
var float bearOBTopV  = na
var float bearOBBotV  = na
var float bearOBPOIv  = na
var line  bearOBPOIln = na

// tap-check runs before creation so a same-bar tap-then-reform works
if not na(bullOBBox)
    if low <= bullOBTopV and high >= bullOBBotV
        box.delete(bullOBBox)
        line.delete(bullOBPOIln)
        bullOBBox := na
    else
        box.set_left(bullOBBox, bar_index - obWidthBars + 1)
        box.set_right(bullOBBox, bar_index + 1)
        line.set_x1(bullOBPOIln, bar_index - obWidthBars + 1)
        line.set_x2(bullOBPOIln, bar_index + 1)

if not na(bearOBBox)
    if low <= bearOBTopV and high >= bearOBBotV
        box.delete(bearOBBox)
        line.delete(bearOBPOIln)
        bearOBBox := na
    else
        box.set_left(bearOBBox, bar_index - obWidthBars + 1)
        box.set_right(bearOBBox, bar_index + 1)
        line.set_x1(bearOBPOIln, bar_index - obWidthBars + 1)
        line.set_x2(bearOBPOIln, bar_index + 1)

if useOB and bullOBevent and na(bullOBBox)
    bullOBTopV  := high[1]
    bullOBBotV  := low[1]
    bullOBPOIv  := obPOI
    bullOBBox   := box.new(bar_index - obWidthBars + 1, bullOBTopV, bar_index + 1, bullOBBotV, border_color = color.teal, bgcolor = bullOBColor, extend = extend.none)
    bullOBPOIln := line.new(bar_index - obWidthBars + 1, bullOBPOIv, bar_index + 1, bullOBPOIv, color = color.teal, width = 1, style = line.style_dashed)

if useOB and bearOBevent and na(bearOBBox)
    bearOBTopV  := high[1]
    bearOBBotV  := low[1]
    bearOBPOIv  := obPOI
    bearOBBox   := box.new(bar_index - obWidthBars + 1, bearOBTopV, bar_index + 1, bearOBBotV, border_color = color.red, bgcolor = bearOBColor, extend = extend.none)
    bearOBPOIln := line.new(bar_index - obWidthBars + 1, bearOBPOIv, bar_index + 1, bearOBPOIv, color = color.red, width = 1, style = line.style_dashed)

// ══════════════════════════════════════════════════════════════════
// STAGE 2b: PD ARRAYS — Rejection Blocks & Inverse Rejection Blocks
// ══════════════════════════════════════════════════════════════════
// RB forms from a wick that rejects a swept high/low. Fib anchored to the
// candle's own high(1)/low(0), CE(0.5) = midpoint:
//   Bullish RB (rejects lower prices): use top(1) and CE(0.5), never bottom(0).
//   Bearish RB (rejects higher prices): use bottom(0) and CE(0.5), never top(1).
// iRB forms when an RB's full range gets closed through (not just touched) -
// it inverts, and the *new* direction's usage rule applies to the same box.
//
// Not yet implemented (follow-up pass): Failure Swing + RB reclassification,
// and RB forming from a PLC/PHC rejection (only the liquidity-sweep trigger
// is covered here).

gRB            = "Rejection Blocks"
useRB          = input.bool(true, "Show Rejection Blocks / iRB", group = gRB)
rbWickRatio    = input.float(50, "Min wick (% of candle range)", minval = 0, maxval = 100, group = gRB) / 100
rbSweepLookback = input.int(20, "Sweep reference lookback (bars)", minval = 5, group = gRB)
rbSweepTicks   = input.int(1, "Min sweep beyond prior extreme (ticks)", minval = 0, group = gRB)
rbWidthBars    = input.int(6, "RB/iRB box width (bars)", minval = 1, group = gRB)
bullRBColor    = input.color(color.new(color.teal, 85), "Bullish RB color", group = gRB)
bearRBColor    = input.color(color.new(color.red, 85), "Bearish RB color", group = gRB)
bullIRBColor   = input.color(color.new(color.blue, 80), "Bullish iRB color", group = gRB)
bearIRBColor   = input.color(color.new(color.orange, 80), "Bearish iRB color", group = gRB)

rbBarRange = high - low
rbUpperWick = high - math.max(open, close)
rbLowerWick = math.min(open, close) - low

rbPriorHigh = ta.highest(high, rbSweepLookback)[1]
rbPriorLow  = ta.lowest(low, rbSweepLookback)[1]
rbSweptHigh = not na(rbPriorHigh) and high >= rbPriorHigh + rbSweepTicks * tick
rbSweptLow  = not na(rbPriorLow) and low <= rbPriorLow - rbSweepTicks * tick

bullRBevent = useRB and rbBarRange > 0 and (rbLowerWick / rbBarRange) >= rbWickRatio and rbSweptLow
bearRBevent = useRB and rbBarRange > 0 and (rbUpperWick / rbBarRange) >= rbWickRatio and rbSweptHigh

var box   bullRBBox   = na
var float bullRBTop   = na
var float bullRBBot   = na
var line  bullRBPOIln = na

var box   bearRBBox   = na
var float bearRBTop   = na
var float bearRBBot   = na
var line  bearRBPOIln = na

var box   bullIRBBox   = na
var float bullIRBTop   = na
var float bullIRBBot   = na
var line  bullIRBPOIln = na

var box   bearIRBBox   = na
var float bearIRBTop   = na
var float bearIRBBot   = na
var line  bearIRBPOIln = na

// ── iRB: plain tap-check first (runs before RB invert-check below, so a
// freshly-spawned iRB this bar isn't immediately self-tapped by the same
// bar's data that created it) ──────────────────────────────────────────────
if not na(bullIRBBox)
    if low <= bullIRBTop and high >= bullIRBBot
        box.delete(bullIRBBox)
        line.delete(bullIRBPOIln)
        bullIRBBox := na
    else
        box.set_left(bullIRBBox, bar_index - rbWidthBars + 1)
        box.set_right(bullIRBBox, bar_index + 1)
        line.set_x1(bullIRBPOIln, bar_index - rbWidthBars + 1)
        line.set_x2(bullIRBPOIln, bar_index + 1)

if not na(bearIRBBox)
    if low <= bearIRBTop and high >= bearIRBBot
        box.delete(bearIRBBox)
        line.delete(bearIRBPOIln)
        bearIRBBox := na
    else
        box.set_left(bearIRBBox, bar_index - rbWidthBars + 1)
        box.set_right(bearIRBBox, bar_index + 1)
        line.set_x1(bearIRBPOIln, bar_index - rbWidthBars + 1)
        line.set_x2(bearIRBPOIln, bar_index + 1)

// ── Bullish RB: tap / invert-check ──────────────────────────────────────────────
if not na(bullRBBox)
    if close < bullRBBot
        // closed fully through -> inverts to a bearish iRB (use bottom+CE, not top)
        box.delete(bullRBBox)
        line.delete(bullRBPOIln)
        bullRBBox := na
        if na(bearIRBBox)
            bearIRBTop  := bullRBTop
            bearIRBBot  := bullRBBot
            ce = (bullRBTop + bullRBBot) / 2
            bearIRBBox   := box.new(bar_index - rbWidthBars + 1, bearIRBTop, bar_index + 1, bearIRBBot, border_color = color.orange, bgcolor = bearIRBColor, extend = extend.none)
            bearIRBPOIln := line.new(bar_index - rbWidthBars + 1, ce, bar_index + 1, ce, color = color.orange, width = 1, style = line.style_dashed)
    else if low <= bullRBTop and high >= bullRBBot
        box.delete(bullRBBox)
        line.delete(bullRBPOIln)
        bullRBBox := na
    else
        box.set_left(bullRBBox, bar_index - rbWidthBars + 1)
        box.set_right(bullRBBox, bar_index + 1)
        line.set_x1(bullRBPOIln, bar_index - rbWidthBars + 1)
        line.set_x2(bullRBPOIln, bar_index + 1)

// ── Bearish RB: tap / invert-check ──────────────────────────────────────────────
if not na(bearRBBox)
    if close > bearRBTop
        // closed fully through -> inverts to a bullish iRB (use top+CE, not bottom)
        box.delete(bearRBBox)
        line.delete(bearRBPOIln)
        bearRBBox := na
        if na(bullIRBBox)
            bullIRBTop  := bearRBTop
            bullIRBBot  := bearRBBot
            ce2 = (bearRBTop + bearRBBot) / 2
            bullIRBBox   := box.new(bar_index - rbWidthBars + 1, bullIRBTop, bar_index + 1, bullIRBBot, border_color = color.blue, bgcolor = bullIRBColor, extend = extend.none)
            bullIRBPOIln := line.new(bar_index - rbWidthBars + 1, ce2, bar_index + 1, ce2, color = color.blue, width = 1, style = line.style_dashed)
    else if low <= bearRBTop and high >= bearRBBot
        box.delete(bearRBBox)
        line.delete(bearRBPOIln)
        bearRBBox := na
    else
        box.set_left(bearRBBox, bar_index - rbWidthBars + 1)
        box.set_right(bearRBBox, bar_index + 1)
        line.set_x1(bearRBPOIln, bar_index - rbWidthBars + 1)
        line.set_x2(bearRBPOIln, bar_index + 1)

// ── New RB formation ──────────────────────────────────────────────
if bullRBevent and na(bullRBBox)
    bullRBTop   := high
    bullRBBot   := low
    ce3 = (high + low) / 2
    bullRBBox   := box.new(bar_index - rbWidthBars + 1, bullRBTop, bar_index + 1, bullRBBot, border_color = color.teal, bgcolor = bullRBColor, extend = extend.none)
    bullRBPOIln := line.new(bar_index - rbWidthBars + 1, ce3, bar_index + 1, ce3, color = color.teal, width = 1, style = line.style_dashed)

if bearRBevent and na(bearRBBox)
    bearRBTop   := high
    bearRBBot   := low
    ce4 = (high + low) / 2
    bearRBBox   := box.new(bar_index - rbWidthBars + 1, bearRBTop, bar_index + 1, bearRBBot, border_color = color.red, bgcolor = bearRBColor, extend = extend.none)
    bearRBPOIln := line.new(bar_index - rbWidthBars + 1, ce4, bar_index + 1, ce4, color = color.red, width = 1, style = line.style_dashed)

// ── Bias Table ──────────────────────────────────────────────
f_biasColor(ref) =>
    na(ref) ? color.gray : close > ref ? color.green : color.red
f_biasText(ref) =>
    na(ref) ? "-" : close > ref ? "Above" : "Below"

var table biasTable = table.new(position.top_left, 2, 12, bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.gray)

if showBiasTable and barstate.islast
    refs = array.new<float>()
    names = array.new<string>()
    array.push(names, "Weekly Open")
    array.push(refs, weeklyOpen)
    array.push(names, "Daily Open")
    array.push(refs, dailyOpen)
    array.push(names, "True Day Open")
    array.push(refs, trueDayOpen)
    array.push(names, "8:30 Open")
    array.push(refs, open0830)
    array.push(names, "9:30 Open")
    array.push(refs, open0930)
    array.push(names, "13:30 Open")
    array.push(refs, open1330)
    array.push(names, "PDH")
    array.push(refs, pdh)
    array.push(names, "PDL")
    array.push(refs, pdl)
    array.push(names, "PWH")
    array.push(refs, pwh)
    array.push(names, "PWL")
    array.push(refs, pwl)
    array.push(names, "RS")
    array.push(refs, rsPrice)

    table.cell(biasTable, 0, 0, "Level", text_color = color.white, bgcolor = color.new(color.gray, 40))
    table.cell(biasTable, 1, 0, "Price vs", text_color = color.white, bgcolor = color.new(color.gray, 40))
    for i = 0 to array.size(names) - 1
        ref = array.get(refs, i)
        table.cell(biasTable, 0, i + 1, array.get(names, i), text_color = color.white)
        table.cell(biasTable, 1, i + 1, f_biasText(ref), text_color = f_biasColor(ref))
